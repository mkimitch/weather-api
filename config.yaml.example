# Weather API Caching Proxy Config
# Rename to config.yaml and fill in your details

# Provider API keys
openweather_api_key: "YOUR_OPENWEATHER_API_KEY"
tomorrow_api_key: "YOUR_TOMORROW_API_KEY" # optional; if missing, OWM-only

# Enable/disable providers (allows Tomorrow-only or OWM-only operation)
enable_openweather: true
enable_tomorrow: true

# Canonical API units are ALWAYS metric (tempC, windKph, pressureHpa, mm).
# Legacy units settings are ignored; providers are always requested in metric.
units: "metric"

# Tomorrow Timelines free plans allow at most five days ahead (today + up to 5).
# Set to 8 only if your paid plan supports it; unsupported horizons return 403.
tomorrow_forecast_days: 5

# List of locations to fetch weather for. Each can be city name, lat/lon, or OpenWeather location ID
locations:
  # By city name
  - name: "Chicago,US"
    type: "city"
    query: "Chicago,US"
    timezone: "America/Chicago" # recommended, especially for Tomorrow-only operation
  # By latitude/longitude
  - name: "Eiffel Tower"
    type: "latlon"
    lat: 48.8584
    lon: 2.2945
    timezone: "Europe/Paris"

# How often to refresh weather for each location (minutes)
refresh_interval_minutes: 30

# Scheduler per-provider max attempts in a 24h rolling window.
# Counts reset on restart; HTTP refreshes are not counted by this scheduler budget.
max_calls_per_24h_openweather: 900
max_calls_per_24h_tomorrow: 500

# Cache settings
cache_dir: "./weather_cache"
cache_expiry_minutes: 30

# Server settings
host: "0.0.0.0"
port: 8000
