# Weather API Caching Proxy Config
# Rename to config.yaml and fill in your details

# Provider API keys
# Prefer environment variables OPENWEATHER_API_KEY and TOMORROW_API_KEY.
# Legacy YAML keys remain supported; never commit actual credentials.
openweather_api_key: ""
tomorrow_api_key: ""

# Enable/disable providers (allows Tomorrow-only or OWM-only operation)
enable_openweather: true
enable_tomorrow: true

# Canonical API units are ALWAYS metric (tempC, windKph, pressureHpa, mm).
# Legacy units settings are ignored; providers are always requested in metric.
units: "metric"

# Tomorrow Timelines free plans allow at most five days ahead (today + up to 5).
# Set to 8 only if your paid plan supports it; unsupported horizons return 403.
tomorrow_forecast_days: 5

# OpenWeather remains first by default. Check consumer handling of popBasis
# and null before opting in to Tomorrow-first.
# Environment override: WEATHER_DAILY_PROVIDER_PRIORITY=tomorrow,openweather
daily_provider_priority: [openweather, tomorrow]
daily_max_age_minutes: 90

# List of locations to fetch weather for. Each can be city name, lat/lon, or OpenWeather location ID
locations:
  # By city name
  - name: "Chicago,US"
    type: "city"
    query: "Chicago,US"
    timezone: "America/Chicago" # recommended, especially for Tomorrow-only operation
    # Optional runtime control path for scheduled rich Tomorrow.io conditions. Missing means off.
    # tomorrow_rich_conditions_control_file: "/app/weather_cache/tomorrow-control/chicago.control"
    # Optional regional observation proxy. Enable with an NWS contact User-Agent.
    # observation_station: "KORD"
  # By latitude/longitude
  - name: "Eiffel Tower"
    type: "latlon"
    lat: 48.8584
    lon: 2.2945
    timezone: "Europe/Paris"

# How often to refresh weather for each location (minutes)
refresh_interval_minutes: 30

# Persistent rolling budgets shared by scheduler, HTTP refreshes and city geocoding.
# Account usage by other applications is outside these local counters.
max_calls_per_24h_openweather: 900
max_calls_per_24h_tomorrow: 500
max_calls_per_hour_tomorrow: 25
max_calls_per_second_tomorrow: 3

# Archive all received forecasts, including unselected and partial endpoint days.
history_enabled: true
# Default: <cache_dir>/history.sqlite3. Override with WEATHER_HISTORY_DB if needed.
# history_db: "./weather_cache/history.sqlite3"
history_retention_days: 400

# Runs inside the existing scheduler; no separate cron/container required.
observations_enabled: true
observation_interval_minutes: 60
observation_lookback_days: 3 # bounded to 1-7; retries recent QC corrections
# Set NWS_USER_AGENT to e.g. "weather-api (your contact email)".
# Collection records a failure until contact information is configured.
nws_user_agent: ""

# Cache settings
cache_dir: "./weather_cache"
cache_expiry_minutes: 30

# Server settings
host: "0.0.0.0"
port: 8000
